# Copy to .env.local and fill in. Both are read at runtime by lib/mongodb.js.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
MONGODB_DB="bus_seat_booking"

# Admin account, seeded on first sign-in if that email has no admin document yet.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="<a long random password>"

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="<32+ random characters>"
